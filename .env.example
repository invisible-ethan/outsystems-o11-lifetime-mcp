# LifeTime environment root (scheme + host). Trailing /lifetime is stripped if present.
# Example: https://example-lt.company.com
LIFETIME_URL=

# Service account authentication token from LifeTime User Management → Service Accounts
LIFETIME_TOKEN=

# Optional: override the full API base URL instead of deriving from LIFETIME_URL
# Example: https://example-lt.company.com/lifetimeapi/rest/v2
# LIFETIME_API_BASE_URL=
